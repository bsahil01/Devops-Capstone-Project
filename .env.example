# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication
JWT_SECRET=supersecretdevopscapstonekey_change_in_production
JWT_EXPIRES_IN=24h

# Database Configuration
# Set DB_TYPE to 'sqlite' for zero-dependency local use, or 'postgres' for PostgreSQL
DB_TYPE=sqlite
DATABASE_FILE=./data/app.db

# If using PostgreSQL (e.g. in Docker Compose):
# DB_TYPE=postgres
# DATABASE_URL=postgres://postgres:postgres@db:5432/employeedb
